<!-- Headerを読み込む -->
<%- include('../components/header') %>

<!-- モバイル向けビューポート設定 -->
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no"
/>

<div class="content">
  <h2 class="responsive-title">画像生成補助ツール</h2>

  <!-- モバイル用タブ切り替えUI -->
  <div class="mobile-tabs">
    <button id="blocklyTab" class="mobile-tab active">ブロック編集</button>
    <button id="outputTab" class="mobile-tab">プロンプト確認</button>
  </div>

  <div id="pageContainer">
    <div id="blocklyDiv" class="active-view"></div>
    <div id="outputPane" class="hidden-view">
      <div class="prompt-header">
        <h3>プロンプト確認</h3>
        <p class="prompt-subtitle">
          下記のプロンプトから1つ選択して画像生成できます
        </p>
      </div>

      <div id="generatedCode" class="prompt-container">
        <!-- ここにプロンプトリストが表示されます -->
      </div>

      <div class="api-controls">
        <button id="generateImagesBtn" class="api-button">
          画像生成
        </button>
        <div id="apiLoadingIndicator" class="loading-indicator hidden">
          <span class="loader"></span>
          <span class="loading-text">リクエスト処理中...</span>
        </div>
      </div>

      <div id="apiErrorContainer" class="error-container hidden">
        <div class="error-icon">⚠️</div>
        <p id="apiErrorMessage"></p>
      </div>

      <div class="result-container">
        <h3 class="result-header">生成結果</h3>
        <div id="generatedImagesContainer" class="image-container">
          <!-- ここに画像が追加されます -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- スタイルとスクリプト -->
<link rel="stylesheet" href="/stylesheets/pages/Blockly.css" />
<!-- Blocklyライブラリを compressedファイルで読み込み -->
<script src="../../node_modules/blockly/blockly_compressed.js"></script>
<script src="../../node_modules/blockly/blocks_compressed.js"></script>
<script src="../../node_modules/blockly/javascript_compressed.js"></script>
<!-- ページ固有のJavaScriptの読み込み -->
<script type="module" src="/javascripts/pages/Blockly.js"></script>
<!-- Footerを読み込む -->
<%- include('../components/footer') %>
